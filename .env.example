APP_NAME=Enterprise Multi-Agent Platform
ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Local / AWS mode ---
LOCAL_MODE=true
ALLOW_DEMO_AUTH=true

# --- AWS core ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Bedrock ---
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_MAX_RETRIES=3

# --- Secrets Manager ---
USE_AWS_SECRETS_MANAGER=false
AWS_SECRET_NAME=enterprise-multi-agent

# --- S3 ---
S3_BUCKET_NAME=
S3_PREFIX=enterprise-multi-agent

# --- DynamoDB ---
DYNAMODB_TABLE_NAME=
DYNAMODB_REGION=us-east-1

# --- Database (SQLite local / Postgres/RDS in prod) ---
DATABASE_URL=sqlite:///./enterprise_multi_agent.db
DATABASE_ECHO=false

# --- App ---
MAX_MESSAGE_LENGTH=5000
LOG_LEVEL=INFO
API_TOKENS=user-demo-token:user,admin-demo-token:admin
RATE_LIMIT_REQUESTS_PER_MINUTE=60
